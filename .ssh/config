Host *
  SendEnv LANG LC_*
  ForwardX11 no
  ForwardAgent yes
  ServerAliveInterval 15
  ConnectTimeout 20

# GitLab.com
Host gitlab.com
  PreferredAuthentications publickey
  IdentityFile ~/.ssh/id_rsa_gitlab

# Private GitLab instance
Host gitlab.cee.redhat.com
  PreferredAuthentications publickey
  IdentityFile ~/.ssh/id_rsa_gitlab

# VM
Host localvm
  User kingsley
  Hostname localhost
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  Port 2222
  ForwardAgent yes

Host github.com
  User git
  Hostname ssh.github.com
  PreferredAuthentications publickey
  IdentityFile ~/.ssh/github

Host mac
  User zissou
  Hostname mac-mini
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null

Host raspi
  User kingsley
  Hostname raspi
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
