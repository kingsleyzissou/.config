// based on: https://github.com/LierB/fastfetch
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/home/kingsley/.config/fastfetch/saturn.txt",
    "padding": {
      "right": 6
    }
  },
  "display": {
    "color": "36"
  },
  "modules": [
    "break",
    "break",
    {
      "type": "title",
      "keyWidth": 10
    },
    "break",
    {
      "type": "os",
      "key": " ",
      "keyColor": "35"
    },
    {
      "type": "kernel",
      "key": " ",
      "keyColor": "35"
    },
    {
      "type": "packages",
      "key": " ",
      "keyColor": "35"
    },
    {
      "type": "shell",
      "key": " ",
      "keyColor": "35"
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "35"
    },
    {
      "type": "wm",
      "key": " ",
      "keyColor": "35"
    },
    {
      "type": "uptime",
      "key": " ",
      "keyColor": "35"
    },
    "break",
    {
      "type": "colors",
      "block": {
        "range": [
          9,
          15
        ]
      }
    }
  ]
}
