#!/bin/bash

DOTFILES="$(cd "$(dirname "$0")" && pwd)"
PLATFORM="$(uname -s | tr '[:upper:]' '[:lower:]')"

echo "Syncing dotfiles from ${DOTFILES}"
echo "Platform: ${PLATFORM}"

# --no-folding creates individual file symlinks instead of directory symlinks.
# This is needed for directories like .config/opencode/ where runtime files
# (node_modules, etc.) coexist with tracked config files.
echo "Stowing base configs..."
stow --no-folding -d "$DOTFILES" -t "$HOME" base

# Rebuild bat theme/syntax cache
if command -v bat &>/dev/null; then
  echo "Rebuilding bat cache..."
  bat cache --build
fi

# In containers, base configs are all we need.
if [ "$CONTAINER_ID" = "lima" ]; then
  echo "Container detected (CONTAINER_ID=$CONTAINER_ID), skipping workstation configs."
  echo "Done."
  exit 0
fi

# workstation/ contains configs only needed on full workstations
# (ghostty, tmux, ssh, gpg, gitconfig, etc.)
echo "Stowing workstation configs..."
stow --no-folding -d "$DOTFILES" -t "$HOME" workstation

case "$PLATFORM" in
  darwin)
    echo "Stowing macOS configs..."
    stow --no-folding -d "$DOTFILES" -t "$HOME" darwin
    PROJECTS_DIR="$HOME/Projects"
    ;;
  linux)
    echo "Stowing Linux configs..."
    stow --no-folding -d "$DOTFILES" -t "$HOME" linux
    # we have some custom icons here, maybe symlinking isn't the best
    # option, but it's what we did before. This maintains the same behaviour
    ln -s /var/home/kingsley/.dotfiles/linux/.config/ags/assets ~/.local/share/icons
    PROJECTS_DIR="$HOME/projects"
    ;;
  *)
    echo "Unknown platform: $PLATFORM"
    ;;
esac

# sync the main .envrc files
mkdir -p "$PROJECTS_DIR/play"
ln -sf "$DOTFILES/base/.envrc.main" "$HOME/.envrc"
ln -sf "$DOTFILES/base/.envrc.play" "$PROJECTS_DIR/play/.envrc"

# Make dotsync available in PATH
mkdir -p "$HOME/bin"
ln -sf "$DOTFILES/dotsync" "$HOME/bin/dotsync"

echo "Done."
