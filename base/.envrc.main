_google=$(pass show google/vertex)
export GOOGLE_GENERATIVE_AI_API_KEY=$(echo "$_google" | head -n1)
export GOOGLE_CLOUD_PROJECT=$(echo "$_google" | awk -F': ' '/^project:/ {print $2}')
export VERTEX_PROJECT_ID=$(echo "$_google" | awk -F': ' '/^project:/ {print $2}')
export VERTEX_LOCATION=$(echo "$_google" | awk -F': ' '/^location:/ {print $2}')
export VERTEX_REGION=$(echo "$_google" | awk -F': ' '/^location:/ {print $2}')
unset _google

export GH_TOKEN="$(pass show github/token)"
