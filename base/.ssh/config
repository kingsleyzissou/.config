Host *
  SendEnv LANG LC_*
  ForwardX11 no
  ForwardAgent yes
  ServerAliveInterval 15
  ConnectTimeout 20

# GitLab.com
Host gitlab.com
  PreferredAuthentications publickey
  IdentityFile ~/.ssh/mini

# Private GitLab instance
Host gitlab.cee.redhat.com
  PreferredAuthentications publickey
  IdentityFile ~/.ssh/mini

Host github.com
  User git
  Hostname ssh.github.com
  PreferredAuthentications publickey
  IdentityFile ~/.ssh/mini
  IdentityFile ~/.ssh/github

# VM
Host localvm
  User kingsley
  Hostname localhost
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  IdentityFile ~/.ssh/mini
  IdentityFile ~/.ssh/arch
  IdentityFile ~/.ssh/linux
  Port 2222
  ForwardAgent yes
  RemoteForward 5556 localhost:5556

Host linux
  User kingsley
  Hostname zissou
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null

Host mac
  User zissou
  Hostname mac-mini
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null

Host raspi
  User kingsley
  Hostname raspi
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
