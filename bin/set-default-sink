#!/usr/bin/bash

DEFAULT=alsa_output.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__HDMI1__sink
CONNECTED=$(pactl list short sinks | grep -c "$DEFAULT")
IS_DEFAULT=$(pactl get-default-sink | grep -c "$DEFAULT")

# Ensure that the default is set, if it is connected and
# not already the default
if [ "$CONNECTED" -gt 0 ] && [ "$IS_DEFAULT" -eq 0 ]; then
  pactl get-default-sink
  pactl set-default-sink "${DEFAULT}"
  pactl get-default-sink
fi
